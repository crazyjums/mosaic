{
  "id": "feishu",
  "name": "飞书",
  "version": "0.2.0",
  "description": "用你自己的飞书账号登录，让模型读取你的飞书文档和群消息（只读，不会发消息或改文档）。基于飞书官方命令行 lark-cli。",
  "min_app_version": "1.6.0",
  "protocol": 1,
  "skills": [
    {
      "path": "skills/feishu"
    }
  ],
  "commands": [
    {
      "name": "feishu-doc",
      "path": "commands/feishu-doc.md",
      "description": "读取并总结一篇飞书文档"
    },
    {
      "name": "feishu-chat",
      "path": "commands/feishu-chat.md",
      "description": "读取一个群的最近消息并总结"
    }
  ],
  "mcp": [
    {
      "command": "python3",
      "args": [
        "${PLUGIN_DIR}/server/feishu.py",
        "mcp"
      ],
      "sensitive": true
    }
  ],
  "status": {
    "command": "python3 ${PLUGIN_DIR}/server/feishu.py status",
    "ok_path": "ok"
  },
  "actions": [
    {
      "id": "init",
      "label": "初始化应用配置（首次使用）",
      "command": "python3 ${PLUGIN_DIR}/server/feishu.py init"
    }
  ],
  "requires": {
    "commands": [
      "python3",
      "lark-cli"
    ]
  },
  "network": [
    "open.feishu.cn",
    "open.larksuite.com",
    "accounts.feishu.cn"
  ],
  "login": {
    "label": "登录飞书",
    "start": "python3 ${PLUGIN_DIR}/server/feishu.py login-start --data-dir ${DATA_DIR}",
    "finish": "python3 ${PLUGIN_DIR}/server/feishu.py login-wait --data-dir ${DATA_DIR}",
    "url_hosts": [
      "*.feishu.cn",
      "*.larksuite.com",
      "*.larkoffice.com"
    ]
  }
}
